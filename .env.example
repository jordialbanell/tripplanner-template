# Copy to .env.local and fill in. Only the first block is required to run the app.

# --- Required ---
# Supabase project (Settings > API). The service role key stays on the server, never in the browser.
SHARED_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SHARED_SUPABASE_SERVICE_ROLE_KEY=
# Your owner sign-in: pick any password, and a long random string for signing the cookie
# (for example: openssl rand -hex 32)
PROJECTS_OWNER_PASSWORD=
PROJECTS_OWNER_SECRET=
# Mapbox public token (account.mapbox.com > Tokens) for the maps
NEXT_PUBLIC_TRIP_MAPBOX_TOKEN=
# Anthropic API key (console.anthropic.com): pulls places out of links, the planning chat
TRIP_ANTHROPIC_API_KEY=
# Google Places API key (Google Cloud > Places API (New)): finds and verifies places, photos
TRIP_GOOGLE_PLACES_API_KEY=

# --- Optional ---
# Reading TikTok / Instagram posts and transcribing their audio
TRIP_APIFY_API_TOKEN=
TRIP_ASSEMBLYAI_API_KEY=
# Amazon Bedrock, for short place descriptions and the day-plan draft (falls back gracefully if unset)
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=ap-southeast-2
# Model overrides
TRIP_ANTHROPIC_IMPORT_MODEL=claude-sonnet-5-5
TRIP_CHAT_MODEL=claude-haiku-5-5
DESCRIBE_MODEL_ID=amazon.nova-lite-v1:0
